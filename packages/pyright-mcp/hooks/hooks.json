{
    "description": "Pyright plugin hooks — verify dev build exists at session start",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-build.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
