{
    "description": "Pyright plugin hooks — session build check + file-intelligence enrichment",
    "hooks": {
        "SessionStart": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-build.sh",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Read",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ${CLAUDE_PLUGIN_ROOT}/dist/hooks/enrich-file.js",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
